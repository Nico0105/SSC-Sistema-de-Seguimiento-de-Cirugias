# --- Base de datos -------------------------------------------------
DATABASE_URL="postgresql://ssc_user:ssc_pass_segura@localhost:5432/ssc_db"

# --- Autenticación -------------------------------------------------
# String aleatorio de al menos 32 caracteres. OBLIGATORIO en producción.
JWT_SECRET="cambiar-por-string-aleatorio-de-al-menos-32-caracteres"

# --- Servidor ------------------------------------------------------
PORT=4000
CORS_ORIGIN="http://localhost:3000"
NODE_ENV="development"

# --- Emails transaccionales (Brevo, plan gratuito) -----------------
# API key de https://www.brevo.com (SMTP & API → API Keys). Si falta,
# los emails se registran en EmailLog como "omitido" y el sistema
# sigue funcionando. Probar con: npm run email:test -- tu@email.com
BREVO_API_KEY=""
# Remitente: tiene que estar verificado en Brevo (Senders, Domains &
# Dedicated IPs → Senders). No hace falta tener dominio propio.
EMAIL_FROM_ADDRESS=""
EMAIL_FROM_NAME="MediQ's"

# --- Notificaciones push (Firebase Cloud Messaging) ----------------
# Credencial del service account de Firebase. Usar UNA de las dos:
#   a) el JSON completo codificado en base64:
FIREBASE_SERVICE_ACCOUNT_BASE64=""
#   b) o la ruta a un archivo .json local (no commitear el archivo):
FIREBASE_SERVICE_ACCOUNT_PATH=""
