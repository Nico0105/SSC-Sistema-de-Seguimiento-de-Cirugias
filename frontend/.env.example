# URL base del backend
VITE_API_URL=http://localhost:4000

# --- Push web (Firebase Cloud Messaging) — opcional ---------------
# Configuración PÚBLICA del proyecto de Firebase. Si falta alguna,
# las notificaciones push web quedan deshabilitadas sin romper nada.
# Completar también frontend/public/firebase-messaging-sw.js.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Clave VAPID pública (Firebase Console → Cloud Messaging → Web Push).
VITE_FIREBASE_VAPID_KEY=
